// Configuración de despliegue en Cloudflare (Workers con assets estáticos)
// El sitio se construye con `npm run build` y queda en ./dist — aquí se lo indicamos.
{
  "name": "stayinvallarta",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
