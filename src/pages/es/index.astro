---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Stay in Vallarta — Departamentos en renta en Puerto Vallarta"
  description="Departamentos de dueños locales en Versalles y Fluvial Vallarta. Reserva directa, estancias mensuales y conocimiento local de verdad."
  lang="es"
>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 bg-siv-mist px-6 text-center">
    <p class="text-sm font-semibold tracking-widest text-siv-gold-dark uppercase">
      Próximamente · Agosto 2026
    </p>
    <h1 class="text-3xl font-bold text-siv-blue-dark">Stay in Vallarta</h1>
    <p class="max-w-xl text-lg text-siv-gray">
      20 departamentos de dueños locales en Versalles y Fluvial Vallarta — los
      vecindarios residenciales favoritos de Puerto Vallarta.
    </p>
    <nav class="flex gap-4 text-siv-blue-dark underline">
      <a href="/">English</a>
      <a href="/fr/">Français</a>
    </nav>
  </main>
</Base>
