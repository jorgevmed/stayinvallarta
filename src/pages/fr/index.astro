---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Stay in Vallarta — Appartements à louer à Puerto Vallarta"
  description="Appartements de propriétaires locaux à Versalles et Fluvial Vallarta. Réservation directe, séjours mensuels et vraies connaissances locales."
  lang="fr"
>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 bg-siv-mist px-6 text-center">
    <p class="text-sm font-semibold tracking-widest text-siv-gold-dark uppercase">
      Bientôt disponible · Août 2026
    </p>
    <h1 class="text-3xl font-bold text-siv-blue">Stay in Vallarta</h1>
    <p class="max-w-xl text-lg text-siv-gray">
      20 appartements de propriétaires locaux à Versalles et Fluvial Vallarta —
      les quartiers résidentiels préférés de Puerto Vallarta.
    </p>
    <nav class="flex gap-4 text-siv-blue-dark underline">
      <a href="/">English</a>
      <a href="/es/">Español</a>
    </nav>
  </main>
</Base>
