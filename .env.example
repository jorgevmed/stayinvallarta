# Stay in Vallarta website — environment variables
# Copy to .env and fill in. All PUBLIC_ vars are exposed to the browser (safe: anon key only).

# Supabase (read published photos + future content)
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Cloudflare R2 custom domain (proxied) used for on-the-fly image transforms.
# Example: https://img.stayinvallarta.com  (NO trailing slash, NO /cdn-cgi/image)
PUBLIC_IMG_BASE=https://img.stayinvallarta.com
