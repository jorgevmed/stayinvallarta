{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "//": "El corte es INDEXABLE vs NOINDEX, no galería vs no-galería. La categoría SEO de Lighthouse contiene la auditoría 'la página está bloqueada para indexación', que una página noindex reprueba POR DEFINICIÓN. Toda página noindex (galerías, 404, vista previa interna) queda fuera de esa categoría; el resto de presupuestos sí aplican a todas. Al añadir una página noindex hay que añadirla a AMBOS patrones o el CI se pone en rojo.",
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*(/gallery/|/404\\.html|/listings-demo)).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],

            "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],

            "resource-summary:script:size": ["error", { "maxNumericValue": 51200 }]
          }
        },
        {
          "matchingUrlPattern": "(/gallery/|/404\\.html|/listings-demo)",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],

            "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],

            "resource-summary:script:size": ["error", { "maxNumericValue": 51200 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
